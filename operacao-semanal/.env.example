# Variáveis de ambiente — App "Operação Semanal" (LOV).
# Copiar para `.env` (que está no .gitignore) e preencher. Em produção (Fly),
# os SEGREDOS definem-se com `fly secrets set`, não neste ficheiro.

# ── Base de dados ────────────────────────────────────────────────────────────
# Dev: SQLite local (default do schema). Prod: Postgres (ver docs/DEPLOY.md).
DATABASE_URL="file:dev.sqlite"

# ── App Shopify embebida (modelo OAuth / Partners) ──────────────────────────
# Necessárias para correr a app embebida no admin (shopify app dev / deploy).
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SCOPES="read_orders,read_products"
SHOPIFY_APP_URL=""

# ── Ligação de dados por TOKEN estático (custom app) ────────────────────────
# Caminho mais simples para ler as encomendas da loja SEM o fluxo OAuth: uma
# custom app criada no admin da loja dá um Admin API access token. Basta
# preencher estas duas e a app passa a ler a loja real (ver provider.server.ts).
# Deixar vazias → a app usa os dados de demonstração / import de CSV.
SHOPIFY_SHOP="legumes-e-outros-vicios.myshopify.com"
SHOPIFY_ADMIN_TOKEN=""

# ── Flags ────────────────────────────────────────────────────────────────────
# DEMO_DATA=1 força os dados de demonstração mesmo com ligação disponível
# (útil para demos). Em produção, deixar vazio/removido.
# DEMO_DATA="1"
